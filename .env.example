# --- server ---
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# --- auth (required when HOST is not loopback) ---
AUTH_ENABLED=false
# API_KEY=change-me
# ADMIN_API_KEY=change-me-too

# --- PostgreSQL (docker compose: host port 5433) ---
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5433/agent

# --- MinIO artifacts (docker compose: 9000 API, 9001 console) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=artifacts
MINIO_SECURE=false

# --- model (any OpenAI-compatible endpoint: Groq, OpenRouter, vLLM, ...) ---
LLM_API_KEY=
BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Comma-separated, same endpoint, tried in order when the primary model fails
LLM_FALLBACK_MODELS=
# Retries per model call on transient errors (connection dropped mid-stream, timeout, 429, 5xx)
MODEL_MAX_RETRIES=2
# Cap per model call; a repetition loop ends here at worst
MODEL_MAX_OUTPUT_TOKENS=8192
# Abort + retry a call that leaks its reasoning ("We need to produce...") or loops on one sentence
MODEL_OUTPUT_GUARD=true
# reasoning_effort for models that support it (values are provider-specific; empty = provider default)
MODEL_REASONING_EFFORT=
# Clear old tool outputs from the model context above this many tokens (0 = never)
CONTEXT_CLEAR_TRIGGER_TOKENS=100000

# --- sources & skills ---
# Optional; raises GitHub's rate limit. Use a fine-grained token with "Public repositories (read-only)".
# GITHUB_TOKEN=
ENABLED_SOURCES=github,blog
# Comma-separated host allowlist; empty = any public host
ALLOWED_HOSTS=
SOURCE_CACHE_TTL_S=3600
# Operator-added skills (declarative only, hooks never run)
# SKILLS_USER_DIR=./skills
# Symbol-level code graph (github_code_graph); needs `uv sync --extra graph`
CODE_GRAPH_MAX_FILES=5000
CODE_GRAPH_TIMEOUT_S=180
SYSTEM_MAP_MAX_FILES=3000

# --- policies ---
# explicit | deny | allow
EXPORT_MODE=explicit
LIMITS__MAX_MODEL_CALLS=12
LIMITS__MAX_TOOL_CALLS=24
LIMITS__TURN_TIMEOUT_S=180
LIMITS__MAX_FETCH_BYTES=2000000
# The most a skill (frontmatter `limits:`) may raise the per-turn budget to, e.g. github-deep-dive
LIMITS_CEILING__MAX_MODEL_CALLS=60
LIMITS_CEILING__MAX_TOOL_CALLS=200
LIMITS_CEILING__TURN_TIMEOUT_S=1200
